# Copy this file to .env and fill in your values.

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=

# Database name inside the cluster
MONGO_DB=social-app

# Port for the Express API
PORT=5000

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional image CDN. When omitted, production stores images in MongoDB and
# local development saves them to server/uploads.
CLOUDINARY_URL=

# Optional override: "mongo" stores images in MongoDB, "local" uses
# server/uploads. Production defaults to MongoDB.
# STORE_IMAGES=
