# Copy this file to .env and fill in your values.

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=

# Database name inside the cluster
MONGO_DB=social-app

# Port for the Express API
PORT=5000

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=replace-me-with-a-long-random-string

# Required in production. Without this, images are saved to server/uploads,
# which is fine for local development but not for hosts with an ephemeral
# filesystem such as Back4App Containers.
CLOUDINARY_URL=
